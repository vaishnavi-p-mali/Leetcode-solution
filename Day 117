class Solution {
    public int numDistinct(String s, String t) {
        int m = s.length();
        int n = t.length();
        
        // dp[i][j] = number of distinct subsequences of s[0..i-1] that equals t[0..j-1]
        long[][] dp = new long[m + 1][n + 1];
        
        // Base case: An empty t can always be formed by deleting all characters of s
        for (int i = 0; i <= m; i++) {
            dp[i][0] = 1;
        }
        
        // Fill the dp table
        for (int i = 1; i <= m; i++) {
            for (int j = 1; j <= n; j++) {
                if (s.charAt(i - 1) == t.charAt(j - 1)) {
                    // Two options: match or skip
                    dp[i][j] = dp[i - 1][j - 1] + dp[i - 1][j];
                } else {
                    // Skip current character of s
                    dp[i][j] = dp[i - 1][j];
                }
            }
        }
        
        // Final answer
        return (int) dp[m][n];
    }
}
