class Solution {
    public int maxProfit(int[] prices) {
        if (prices == null || prices.length == 0) return 0;

        int buy1 = Integer.MIN_VALUE;   // Max profit after first buy
        int sell1 = 0;                  // Max profit after first sell
        int buy2 = Integer.MIN_VALUE;   // Max profit after second buy
        int sell2 = 0;                  // Max profit after second sell

        for (int price : prices) {
            // Update states step by step
            buy1 = Math.max(buy1, -price);          // Buy first stock
            sell1 = Math.max(sell1, buy1 + price);  // Sell first stock
            buy2 = Math.max(buy2, sell1 - price);   // Buy second stock
            sell2 = Math.max(sell2, buy2 + price);  // Sell second stock
        }

        return sell2; // Max profit after at most two transactions
    }
}
