class Solution {
    public int firstMissingPositive(int[] nums) {
        int n = nums.length;

        // 1. Use cyclic sort to place each number x at index x - 1
        for (int i = 0; i < n; i++) {
            // While the current number is in the valid range [1, n]
            // AND it is not already at its correct position (nums[i] != nums[nums[i] - 1])
            while (nums[i] > 0 && nums[i] <= n && nums[nums[i] - 1] != nums[i]) {
                // Swap nums[i] with the element at its target index
                int targetIndex = nums[i] - 1;
                int temp = nums[i];
                nums[i] = nums[targetIndex];
                nums[targetIndex] = temp;
            }
        }

        // 2. Scan the array to find the first index where the value is incorrect
        for (int i = 0; i < n; i++) {
            if (nums[i] != i + 1) {
                return i + 1;
            }
        }

        // 3. If all positions are correct, the missing number is n + 1
        return n + 1;
    }
}
