class Solution {
    public int totalNQueens(int n) {
        // Arrays to track columns and diagonals
        boolean[] cols = new boolean[n];          // columns
        boolean[] d1 = new boolean[2 * n];        // main diagonals
        boolean[] d2 = new boolean[2 * n];        // anti-diagonals
        
        return backtrack(0, n, cols, d1, d2);
    }
    
    private int backtrack(int row, int n, boolean[] cols, boolean[] d1, boolean[] d2) {
        if (row == n) {
            return 1; // found a valid solution
        }
        
        int count = 0;
        for (int col = 0; col < n; col++) {
            int id1 = col - row + n;   // main diagonal index
            int id2 = col + row;       // anti-diagonal index
            
            if (cols[col] || d1[id1] || d2[id2]) continue;
            
            // place queen
            cols[col] = d1[id1] = d2[id2] = true;
            
            count += backtrack(row + 1, n, cols, d1, d2);
            
            // remove queen (backtrack)
            cols[col] = d1[id1] = d2[id2] = false;
        }
        return count;
    }
}
