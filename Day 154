class Solution {
    public int maxProduct(int[] nums) {
        // Initialize with the first element
        int maxSoFar = nums[0];
        int minSoFar = nums[0];
        int result = nums[0];

        for (int i = 1; i < nums.length; i++) {
            int current = nums[i];

            // Temporary max because minSoFar will be updated
            int tempMax = Math.max(current, Math.max(maxSoFar * current, minSoFar * current));

            // Update minSoFar (important for handling negatives)
            minSoFar = Math.min(current, Math.min(maxSoFar * current, minSoFar * current));

            // Update maxSoFar with tempMax
            maxSoFar = tempMax;

            // Update result with the best seen so far
            result = Math.max(result, maxSoFar);
        }

        return result;
    }
}
