class Solution {
    public void solve(char[][] board) {
        if (board == null || board.length == 0) return;
        
        int m = board.length;
        int n = board[0].length;
        
        // Step 1: Mark all 'O's connected to border as safe ('#')
        for (int i = 0; i < m; i++) {
            dfs(board, i, 0);        // Left border
            dfs(board, i, n - 1);    // Right border
        }
        for (int j = 0; j < n; j++) {
            dfs(board, 0, j);        // Top border
            dfs(board, m - 1, j);    // Bottom border
        }
        
        // Step 2: Flip surrounded 'O' to 'X' and safe '#' back to 'O'
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                if (board[i][j] == 'O') {
                    board[i][j] = 'X'; // Surrounded region
                } else if (board[i][j] == '#') {
                    board[i][j] = 'O'; // Safe region
                }
            }
        }
    }
    
    // DFS helper to mark connected 'O's
    private void dfs(char[][] board, int i, int j) {
        int m = board.length;
        int n = board[0].length;
        
        if (i < 0 || j < 0 || i >= m || j >= n || board[i][j] != 'O') {
            return;
        }
        
        board[i][j] = '#'; // Mark as safe
        
        // Explore neighbors
        dfs(board, i + 1, j);
        dfs(board, i - 1, j);
        dfs(board, i, j + 1);
        dfs(board, i, j - 1);
    }
}
