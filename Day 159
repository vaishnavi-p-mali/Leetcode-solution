class Solution {
    public int canCompleteCircuit(int[] gas, int[] cost) {
        int totalTank = 0;   // overall net gas balance
        int currTank = 0;    // current tank balance while traversing
        int startIndex = 0;  // candidate starting station

        for (int i = 0; i < gas.length; i++) {
            totalTank += gas[i] - cost[i];
            currTank += gas[i] - cost[i];

            // If at any point current tank goes negative,
            // reset startIndex to next station and reset currTank
            if (currTank < 0) {
                startIndex = i + 1;
                currTank = 0;
            }
        }

        // If totalTank is negative, no solution exists
        return totalTank >= 0 ? startIndex : -1;
    }
}
