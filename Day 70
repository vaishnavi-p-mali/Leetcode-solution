class Solution {
    public int climbStairs(int n) {
        if (n <= 2) return n;  // Base cases: 1 step → 1 way, 2 steps → 2 ways
        
        int first = 1;  // ways to reach step 1
        int second = 2; // ways to reach step 2
        
        for (int i = 3; i <= n; i++) {
            int third = first + second; // ways to reach current step
            first = second;             // move forward
            second = third;
        }
        
        return second; // result for n steps
    }
}
